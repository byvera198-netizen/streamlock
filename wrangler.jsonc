{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamlock",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "WHATSAPP_API_VERSION": "v25.0",
    "WHATSAPP_PHONE_NUMBER_ID": "1404872032704394",
    "STREAMLOCK_ADMIN_EMAILS": "byvera198@gmail.com,bveraalvear@gmail.com"
  },
  "assets": { "directory": "dist/client" },
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "streamlock-receipts" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamlock-db",
      "database_id": "23a80694-54bc-486d-b0a5-0426ac73a0d9",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": { "enabled": true }
}
